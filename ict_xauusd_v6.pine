//@version=6
strategy("XAUUSD Active Scalper M5-M15 v6", shorttitle = "XAUScalp6", overlay = true,
     initial_capital = 10000, currency = currency.USD, pyramiding = 0,
     default_qty_type = strategy.fixed, margin_long = 5, margin_short = 5,
     commission_type = strategy.commission.percent, commission_value = 0.001,
     slippage = 2, backtest_fill_limits_assumption = 1,
     process_orders_on_close = true, calc_on_order_fills = false, calc_on_every_tick = false,
     max_bars_back = 500)

const string G_SIGNAL = "01 | Scalper M5 / M15"
const string G_TIME = "02 | Waktu & berita UTC"
const string G_RISK = "03 | Risiko & exit"
const string G_GUARD = "04 | Batas harian"
const string G_VIEW = "05 | Tampilan"

string setupMode = input.string("Pullback + Sweep", "Jenis setup", options = ["Pullback + Sweep", "Pullback", "Sweep"], group = G_SIGNAL)
int fastLength = input.int(20, "EMA chart cepat", minval = 5, maxval = 199, group = G_SIGNAL)
int slowLength = input.int(50, "EMA chart lambat", minval = 10, maxval = 500, group = G_SIGNAL)
bool useBias = input.bool(true, "Filter bias HTF terkonfirmasi", group = G_SIGNAL)
bool autoBias = input.bool(true, "HTF otomatis: M5 -> M15, M15 -> H1", group = G_SIGNAL)
string manualBiasTf = input.timeframe("60", "HTF manual bila otomatis nonaktif", group = G_SIGNAL)
int biasLength = input.int(50, "EMA bias HTF", minval = 10, maxval = 500, group = G_SIGNAL)
bool useAdx = input.bool(true, "Filter ADX (hindari range lemah)", group = G_SIGNAL)
float minAdx = input.float(18.0, "ADX minimum", minval = 10, maxval = 35, step = 1, group = G_SIGNAL)
int atrLength = input.int(14, "ATR / DMI length", minval = 5, maxval = 100, group = G_SIGNAL)
int sweepLookback = input.int(5, "Lookback sweep lokal (bar sebelumnya)", minval = 2, maxval = 20, group = G_SIGNAL)
float minSweepPips = input.float(1.0, "Penetrasi minimum sweep (pip)", minval = 0.1, maxval = 10, group = G_SIGNAL)
float touchAtr = input.float(0.20, "Toleransi sentuhan EMA x ATR", minval = 0, maxval = 0.5, step = 0.05, group = G_SIGNAL)
float maxChaseAtr = input.float(0.75, "Jarak entry maksimum dari EMA x ATR", minval = 0.1, maxval = 1.5, step = 0.05, group = G_SIGNAL)
float minBodyAtr = input.float(0.15, "Badan trigger minimum x ATR", minval = 0.05, maxval = 0.75, step = 0.05, group = G_SIGNAL)
float maxRangeAtr = input.float(2.0, "Tolak candle spike > x ATR", minval = 1, maxval = 4, step = 0.25, group = G_SIGNAL)
int setupLifeBars = input.int(3, "Masa berlaku setup (bar)", minval = 1, maxval = 10, group = G_SIGNAL)
string entryMode = input.string("Market setelah trigger", "Eksekusi", options = ["Market setelah trigger", "Limit retest EMA"], group = G_SIGNAL)
int limitLifeBars = input.int(2, "Masa berlaku limit (bar)", minval = 1, maxval = 5, group = G_SIGNAL)

string sessionMode = input.string("London-NY 07:00-17:00", "Sesi GMT Senin-Jumat", group = G_TIME,
     options = ["London-NY 07:00-17:00", "Killzone ICT 07-10 / 12-17"],
     tooltip = "Scalper default memakai sesi kontinu, termasuk 10:00-12:00 GMT. Berita tetap diblokir.")
bool calendarReviewed = input.bool(false, "Kalender high-impact sudah diperiksa", group = G_TIME,
     tooltip = "Entri terkunci sampai kalender dan seluruh cakupannya diverifikasi. Pine tidak mengunduh kalender berita.")
string newsSchedule = input.text_area("", "Berita UTC: satu YYYY-MM-DD HH:mm per baris", group = G_TIME,
     tooltip = "Maksimum 500 acara. Blackout inklusif +/-15 menit. Isi jadwal historis lengkap untuk backtest.")
int calendarStart = input.time(0, "Awal cakupan kalender terverifikasi (wajib diisi)", group = G_TIME)
int calendarEnd = input.time(0, "Akhir cakupan kalender terverifikasi (wajib diisi)", group = G_TIME)
int testStart = input.time(timestamp("01 Jan 2024 00:00 +0000"), "Mulai periode entri", group = G_TIME)
int testEnd = input.time(timestamp("01 Jan 2035 00:00 +0000"), "Akhir periode entri", group = G_TIME)

float pipSize = input.float(0.10, "Ukuran 1 pip XAUUSD dalam harga", minval = 0.001, step = 0.01, group = G_RISK)
float riskPercent = input.float(0.5, "Anggaran risiko ekuitas (%)", minval = 0.1, maxval = 1, step = 0.1, group = G_RISK)
float stopBufferPips = input.float(2.0, "Buffer di luar wick pullback/sweep (pip)", minval = 2, maxval = 3, step = 0.5, group = G_RISK)
float minStopPips = input.float(10.0, "SL minimum (pip), bukan minimum TP1", minval = 5, maxval = 40, step = 1, group = G_RISK)
float maxStopPips = input.float(50.0, "SL struktural maksimum (pip)", minval = 10, maxval = 50, step = 1, group = G_RISK)
float tp1R = input.float(1.2, "TP1 dalam R", minval = 1.0, maxval = 2, step = 0.1, group = G_RISK)
float tp2R = input.float(2.0, "TP2 dalam R (harus > TP1)", minval = 1.5, maxval = 4, step = 0.1, group = G_RISK)
float partialPercent = input.float(70.0, "Porsi TP1 (%)", minval = 50, maxval = 80, step = 5, group = G_RISK)
float beAtR = input.float(1.0, "BEP saat profit close mencapai R", minval = 0.75, maxval = 1.5, step = 0.25, group = G_RISK)
int maxHoldMinutes = input.int(60, "Time exit setelah maksimum menit", minval = 15, maxval = 240, step = 15, group = G_RISK)
bool flatAtSessionEnd = input.bool(true, "Tutup sisa posisi di akhir sesi", group = G_RISK)
float qtyStepOverride = input.float(0.0, "Step qty broker (0 = otomatis)", minval = 0, group = G_RISK,
     tooltip = "Qty bukan selalu lot. Otomatis minimal 1 oz dan syminfo.mincontract. Periksa kontrak broker.")
int slippageTicks = input.int(2, "Estimasi slippage (tick) = Properties/Slippage", minval = 0, group = G_RISK)
float commissionPercent = input.float(0.001, "Komisi per sisi (%) = Properties/Commission", minval = 0, step = 0.001, group = G_RISK,
     tooltip = "Input hanya untuk cadangan sizing; tidak mengubah Properties. Default Properties 0.001% per sisi dan slippage 2 tick, bukan tarif broker yang terverifikasi.")

int maxTradesDay = input.int(12, "Batas posisi baru per hari GMT (bukan target)", minval = 1, maxval = 30, group = G_GUARD)
float dailyLossPercent = input.float(2.0, "Hentikan entry saat rugi terealisasi harian (%)", minval = 0.5, maxval = 5, step = 0.5, group = G_GUARD)
int maxLosingStreak = input.int(3, "Batas loss beruntun per hari", minval = 1, maxval = 5, group = G_GUARD)
int cooldownBars = input.int(1, "Cooldown setelah posisi selesai (bar)", minval = 1, maxval = 10, group = G_GUARD)
bool showLevels = input.bool(true, "Plot EMA dan level posisi", group = G_VIEW)
bool showSessions = input.bool(true, "Latar sesi / blackout berita", group = G_VIEW)
bool showDashboard = input.bool(true, "Dashboard frekuensi dan hasil net", group = G_VIEW)
int minimumSample = input.int(100, "Sampel minimum evaluasi WR", minval = 30, maxval = 1000, group = G_VIEW)

string biasTf = autoBias ? (timeframe.multiplier == 5 ? "15" : "60") : manualBiasTf

type ScalpSetup
    int side = 0
    int startBar = na
    float extreme = na
    float reference = na
    float chaseBoundary = na
    string kind = ""

type TradePlan
    bool active = false
    bool filled = false
    bool closing = false
    bool firstLegClosed = false
    bool breakEven = false
    bool market = false
    int side = 0
    int sentBar = na
    float entry = na
    float initialStop = na
    float invalidation = na
    float chaseBoundary = na
    float risk = na
    float tp1 = na
    float tp2 = na
    float qty = na
    float firstQty = na
    float runnerQty = na
    float riskBudget = na
    float netAtStart = na

f_parseNews(string schedule) =>
    array<int> events = array.new_int()
    for eventLine in str.split(schedule, "\n")
        string text = str.trim(eventLine)
        if str.length(text) > 0
            bool shapeOk = str.length(text) == 16 and str.substring(text, 4, 5) == "-" and str.substring(text, 7, 8) == "-" and str.substring(text, 10, 11) == " " and str.substring(text, 13, 14) == ":"
            if not shapeOk
                runtime.error("Format berita harus YYYY-MM-DD HH:mm UTC, satu acara per baris.")
            float y = str.tonumber(str.substring(text, 0, 4))
            float mo = str.tonumber(str.substring(text, 5, 7))
            float d = str.tonumber(str.substring(text, 8, 10))
            float h = str.tonumber(str.substring(text, 11, 13))
            float mi = str.tonumber(str.substring(text, 14, 16))
            bool numbersOk = not na(y) and not na(mo) and not na(d) and not na(h) and not na(mi)
            bool rangeOk = numbersOk and y >= 1970 and y <= 2099 and mo >= 1 and mo <= 12 and d >= 1 and d <= 31 and h >= 0 and h <= 23 and mi >= 0 and mi <= 59
            bool integersOk = rangeOk and y == math.floor(y) and mo == math.floor(mo) and d == math.floor(d) and h == math.floor(h) and mi == math.floor(mi)
            if not integersOk
                runtime.error("Tanggal/jam berita tidak valid: " + text)
            string canonical = str.tostring(int(y), "0000") + "-" + str.tostring(int(mo), "00") + "-" + str.tostring(int(d), "00") + " " + str.tostring(int(h), "00") + ":" + str.tostring(int(mi), "00")
            if canonical != text
                runtime.error("Gunakan angka dua digit untuk bulan, tanggal, jam, dan menit.")
            int stamp = timestamp("GMT+0", int(y), int(mo), int(d), int(h), int(mi))
            if year(stamp, "GMT+0") != int(y) or month(stamp, "GMT+0") != int(mo) or dayofmonth(stamp, "GMT+0") != int(d)
                runtime.error("Tanggal kalender berita tidak valid: " + text)
            array.push(events, stamp)
            if array.size(events) > 500
                runtime.error("Maksimum 500 acara berita. Persempit periode uji.")
    array.sort(events, order.ascending)
    events

f_session(int stamp) =>
    int weekday = dayofweek(stamp, "GMT+0")
    int minuteOfDay = hour(stamp, "GMT+0") * 60 + minute(stamp, "GMT+0")
    bool workingDay = weekday >= dayofweek.monday and weekday <= dayofweek.friday
    bool continuous = minuteOfDay >= 420 and minuteOfDay < 1020
    bool ict = (minuteOfDay >= 420 and minuteOfDay < 600) or (minuteOfDay >= 720 and minuteOfDay < 1020)
    workingDay and (sessionMode == "London-NY 07:00-17:00" ? continuous : ict)

f_newsBlocked(array<int> events, int startTime, int endTime) =>
    int left = 0
    int right = array.size(events) - 1
    bool blocked = false
    while left <= right
        int middle = int(math.floor((left + right) / 2))
        int eventTime = array.get(events, middle)
        if eventTime < startTime - 15 * 60 * 1000
            left := middle + 1
        else if eventTime > endTime + 15 * 60 * 1000
            right := middle - 1
        else
            blocked := true
            break
    blocked

f_windowAllowed(array<int> events, int startTime, int endTime) =>
    calendarReviewed and startTime >= calendarStart and endTime <= calendarEnd and startTime >= testStart and endTime <= testEnd and f_session(startTime) and f_session(endTime) and not f_newsBlocked(events, startTime, endTime)

f_structuralStop(int side, float extreme) =>
    float rawStop = extreme - side * stopBufferPips * pipSize
    side == 1 ? math.floor(rawStop / syminfo.mintick) * syminfo.mintick : math.ceil(rawStop / syminfo.mintick) * syminfo.mintick

f_riskPerUnit(float entry, float stop) =>
    float stopLoss = math.abs(entry - stop) + slippageTicks * syminfo.mintick
    float fees = (math.abs(entry) + math.abs(stop)) * commissionPercent / 100
    (stopLoss + fees) * syminfo.pointvalue

f_wilsonLower(int wins, int count) =>
    float n = count
    float p = count > 0 ? wins / n : na
    count > 0 ? 100 * (p + 3.8416 / (2 * n) - 1.96 * math.sqrt((p * (1 - p) + 3.8416 / (4 * n)) / n)) / (1 + 3.8416 / n) : na

f_price(float value) =>
    na(value) ? "-" : str.tostring(value, format.mintick)

f_row(table panel, int row, string title, string value, color tone) =>
    table.cell(panel, 0, row, title, text_color = color.silver, text_size = size.small)
    table.cell(panel, 1, row, value, text_color = tone, text_size = size.small)

if barstate.isfirst
    if not timeframe.isminutes or (timeframe.multiplier != 5 and timeframe.multiplier != 15)
        runtime.error("Active Scalper: gunakan candle standar M5 atau M15. Versi ICT lama ada di strategies/ict_strict_v6.pine.")
    if not chart.is_standard
        runtime.error("Gunakan candle/bar standar, bukan Heikin Ashi, Renko, atau chart sintetis.")
    if useBias and timeframe.in_seconds(biasTf) <= timeframe.in_seconds()
        runtime.error("HTF bias harus lebih tinggi daripada chart; aktifkan HTF otomatis.")
    if slowLength <= fastLength or minStopPips > maxStopPips or tp2R <= tp1R
        runtime.error("EMA lambat harus > EMA cepat, SL minimum <= maksimum, TP2 R > TP1 R.")
    if testEnd <= testStart or (calendarReviewed and calendarEnd <= calendarStart)
        runtime.error("Isi awal/akhir periode dan cakupan kalender yang valid sebelum mengaktifkan entry.")
    if syminfo.currency != "USD" or syminfo.pointvalue <= 0 or pipSize < syminfo.mintick
        runtime.error("Pilih XAUUSD berkuotasi USD; periksa pointvalue, pip, dan tick simbol.")

var array<int> newsEvents = f_parseNews(newsSchedule)
var ScalpSetup setup = ScalpSetup.new()
var TradePlan trade = TradePlan.new()
var int utcDay = na
var float dayStartNet = 0
var float dayStartEquity = 10000
var int dailyEntries = 0
var int losingStreak = 0
var int closedSeen = 0
var int lastExitBar = na
var int completed = 0
var int winners = 0
var int losers = 0
var float winningPnl = 0
var float losingPnl = 0
var int eligibleDays = 0
var int lastEligibleDay = na
var int totalFills = 0
var int setupCount = 0
var int triggerCount = 0
var int orderCount = 0
var int riskRejected = 0
var int sizingRejected = 0
var int executionRejected = 0
var int cancelledOrders = 0
var string lastStatus = "Verifikasi kalender; mulai dari M5 dan biaya broker yang sesuai."

float atr = ta.atr(atrLength)
float emaFast = ta.ema(close, fastLength)
float emaSlow = ta.ema(close, slowLength)
[diPlus, diMinus, adx] = ta.dmi(atrLength, atrLength)
float previousLow = ta.lowest(low, sweepLookback)[1]
float previousHigh = ta.highest(high, sweepLookback)[1]
// Bias dan zona entry memakai level yang sudah diketahui sebelum candle trigger.
[biasClose, biasEma] = request.security(syminfo.tickerid, biasTf,
     [close[1], ta.ema(close, biasLength)[1]], lookahead = barmerge.lookahead_on)
bool buyBias = emaFast[1] > emaSlow[1] and (not useBias or biasClose > biasEma)
bool sellBias = emaFast[1] < emaSlow[1] and (not useBias or biasClose < biasEma)
bool qualityOk = not useAdx or adx >= minAdx
bool readyHistory = bar_index >= slowLength and not na(atr[1]) and (not useBias or not na(biasEma))
float bandLow = emaFast[1] - touchAtr * atr[1]
float bandHigh = emaFast[1] + touchAtr * atr[1]
bool touchesBand = low <= bandHigh and high >= bandLow
bool buyPullback = touchesBand and close > emaSlow[1]
bool sellPullback = touchesBand and close < emaSlow[1]
bool buySweep = low < previousLow - minSweepPips * pipSize and close > previousLow
bool sellSweep = high > previousHigh + minSweepPips * pipSize and close < previousHigh
bool newBuyPullback = buyPullback and not buyPullback[1]
bool newSellPullback = sellPullback and not sellPullback[1]
bool newBuySweep = buySweep and not buySweep[1]
bool newSellSweep = sellSweep and not sellSweep[1]
bool buyEvent = (setupMode != "Sweep" and newBuyPullback) or (setupMode != "Pullback" and newBuySweep)
bool sellEvent = (setupMode != "Sweep" and newSellPullback) or (setupMode != "Pullback" and newSellSweep)
bool currentWindow = f_windowAllowed(newsEvents, time, time_close)
int nextClose = time_close + int(timeframe.in_seconds() * 1000)
bool nextWindow = f_windowAllowed(newsEvents, time_close, nextClose)
bool newsNow = f_newsBlocked(newsEvents, time, time_close)
float minContract = nz(syminfo.mincontract, 1.0)
float requestedStep = qtyStepOverride > 0 ? qtyStepOverride : math.max(minContract, 1.0 / syminfo.pointvalue)
float qtyStep = math.ceil(requestedStep / minContract) * minContract
float body = math.abs(close - open)
float candleRange = high - low
float lowerWick = math.min(open, close) - low
float upperWick = high - math.max(open, close)
bool spike = candleRange > maxRangeAtr * atr[1]
bool buySetupMark = false
bool sellSetupMark = false
bool buyOrderMark = false
bool sellOrderMark = false

if barstate.isconfirmed
    int dayKey = year(time_close, "GMT+0") * 10000 + month(time_close, "GMT+0") * 100 + dayofmonth(time_close, "GMT+0")
    if na(utcDay) or dayKey != utcDay
        utcDay := dayKey
        dayStartNet := nz(strategy.netprofit[1], strategy.netprofit)
        dayStartEquity := math.max(strategy.initial_capital + dayStartNet, 0)
        dailyEntries := 0
        losingStreak := 0
    if currentWindow and (na(lastEligibleDay) or dayKey != lastEligibleDay)
        eligibleDays += 1
        lastEligibleDay := dayKey

    bool newClosedLegs = strategy.closedtrades > closedSeen
    if trade.active
        bool firstObservedFill = not trade.filled and (strategy.position_size != 0 or newClosedLegs)
        if firstObservedFill
            trade.filled := true
            dailyEntries += 1
            totalFills += 1
        if newClosedLegs
            for i = closedSeen to strategy.closedtrades - 1
                string exitId = strategy.closedtrades.exit_id(i)
                if exitId == "L-TP1" or exitId == "S-TP1"
                    trade.firstLegClosed := true
        if trade.filled and strategy.position_size == 0
            // Satu entry sampai flat, net setelah biaya; parsial bukan kemenangan tambahan.
            float netResult = strategy.netprofit - trade.netAtStart
            completed += 1
            if netResult > 0
                winners += 1
                winningPnl += netResult
                losingStreak := 0
            else if netResult < 0
                losers += 1
                losingPnl += -netResult
                losingStreak += 1
            lastExitBar := bar_index
            lastStatus := "Posisi selesai: $" + str.tostring(netResult, "#.##") + " net"
            strategy.cancel_all()
            trade := TradePlan.new()
        else if strategy.position_size != 0
            if firstObservedFill
                trade.entry := strategy.position_avg_price
                trade.risk := trade.side * (trade.entry - trade.initialStop)
                trade.tp1 := math.round_to_mintick(trade.entry + trade.side * tp1R * trade.risk)
                trade.tp2 := math.round_to_mintick(trade.entry + trade.side * tp2R * trade.risk)
            bool fillRiskOk = trade.risk >= minStopPips * pipSize - syminfo.mintick * 0.001 and trade.risk <= maxStopPips * pipSize + syminfo.mintick * 0.001
            bool fillBudgetOk = f_riskPerUnit(trade.entry, trade.initialStop) * trade.qty <= trade.riskBudget + 0.01
            int filledAt = strategy.opentrades.entry_time(0)
            bool fillTimeOk = f_windowAllowed(newsEvents, filledAt, filledAt)
            bool fillChaseOk = not trade.market or (trade.side == 1 ? trade.entry <= trade.chaseBoundary : trade.entry >= trade.chaseBoundary)
            bool unexpectedReduction = not trade.firstLegClosed and math.abs(strategy.position_size) < trade.qty - qtyStep * 0.1
            bool timeExit = time_close - filledAt >= maxHoldMinutes * 60 * 1000
            bool sessionExit = flatAtSessionEnd and not f_session(time_close)
            bool riskExit = not fillRiskOk or not fillBudgetOk or not fillTimeOk or not fillChaseOk or unexpectedReduction
            if trade.closing or riskExit or timeExit or sessionExit
                trade.closing := true
                strategy.cancel_all()
                string reason = riskExit ? "Fill risk guard" : timeExit ? "Time exit" : "Session exit"
                strategy.close_all(comment = reason, alert_message = reason + ": tutup sisa posisi", immediately = true)
                lastStatus := reason
            else if trade.side * (close - trade.entry) >= beAtR * trade.risk
                trade.breakEven := true

    closedSeen := strategy.closedtrades
    float dayPnl = strategy.netprofit - dayStartNet
    bool dailyAllowed = dayStartEquity > 0 and dayPnl > -dayStartEquity * dailyLossPercent / 100 and dailyEntries < maxTradesDay and losingStreak < maxLosingStreak
    bool cooldownReady = na(lastExitBar) or bar_index - lastExitBar >= cooldownBars
    bool canPrepare = currentWindow and dailyAllowed and cooldownReady and readyHistory and strategy.equity > 0

    if trade.active and not trade.filled and strategy.position_size == 0
        bool staleOrder = bar_index - trade.sentBar >= limitLifeBars
        bool invalidated = trade.side == 1 ? low <= trade.invalidation : high >= trade.invalidation
        bool biasLost = trade.side == 1 ? not buyBias : not sellBias
        if staleOrder or not nextWindow or not dailyAllowed or invalidated or biasLost
            strategy.cancel_all()
            trade := TradePlan.new()
            cancelledOrders += 1
            lastStatus := "Pending dibatalkan: TTL/waktu/berita/struktur/bias."

    if not trade.active and strategy.position_size == 0
        if not canPrepare or not qualityOk or spike or (buySweep and sellSweep)
            setup := ScalpSetup.new()
        else
            bool resetThisBar = false
            if setup.side != 0
                bool staleSetup = bar_index - setup.startBar > setupLifeBars
                bool wrongTrend = setup.side == 1 ? not buyBias or close < emaSlow[1] : not sellBias or close > emaSlow[1]
                if staleSetup or wrongTrend
                    setup := ScalpSetup.new()
                    resetThisBar := true
                    lastStatus := "Setup kedaluwarsa / kehilangan trend."
                else
                    setup.extreme := setup.side == 1 ? math.min(setup.extreme, low) : math.max(setup.extreme, high)
            if setup.side == 0 and not resetThisBar
                bool armBuy = buyEvent and buyBias
                bool armSell = sellEvent and sellBias
                if armBuy != armSell
                    setup.side := armBuy ? 1 : -1
                    setup.startBar := bar_index
                    setup.extreme := armBuy ? low : high
                    setup.reference := emaFast[1]
                    setup.chaseBoundary := setup.reference + setup.side * maxChaseAtr * atr[1]
                    setup.kind := (setupMode != "Pullback" and (armBuy ? newBuySweep : newSellSweep)) ? "Sweep reclaim" : "EMA pullback"
                    setupCount += 1
                    buySetupMark := armBuy
                    sellSetupMark := armSell
                    lastStatus := setup.kind + ": tunggu trigger searah."
            if setup.side != 0
                bool isBuy = setup.side == 1
                bool directional = isBuy ? close > open : close < open
                bool reclaimed = isBuy ? close > setup.reference : close < setup.reference
                bool rejection = candleRange > 0 and (isBuy ? lowerWick >= body and (close - low) / candleRange >= 0.6 : upperWick >= body and (high - close) / candleRange >= 0.6)
                bool engulfing = isBuy ? close[1] < open[1] and open <= close[1] and close >= open[1] : close[1] > open[1] and open >= close[1] and close <= open[1]
                bool minorBreak = isBuy ? close > high[1] : close < low[1]
                bool trigger = directional and reclaimed and body >= minBodyAtr * atr[1] and (rejection or engulfing or minorBreak)
                if trigger
                    triggerCount += 1
                    bool marketOrder = entryMode == "Market setelah trigger"
                    float entry = math.round_to_mintick(marketOrder ? close + setup.side * slippageTicks * syminfo.mintick : setup.reference)
                    float stop = f_structuralStop(setup.side, setup.extreme)
                    float risk = setup.side * (entry - stop)
                    float remainingDailyRisk = math.max(dayStartEquity * dailyLossPercent / 100 + dayPnl, 0)
                    float budget = math.min(strategy.equity * riskPercent / 100, remainingDailyRisk)
                    float perUnit = f_riskPerUnit(entry, stop)
                    float riskQty = perUnit > 0 ? math.floor(budget / perUnit / qtyStep) * qtyStep : 0
                    // Margin model 5%; cadangkan 10% daya beli, tanpa menaikkan risiko.
                    float affordableQty = entry > 0 ? math.floor(strategy.equity * 0.9 / (entry * syminfo.pointvalue * 0.05) / qtyStep) * qtyStep : 0
                    float qty = math.min(riskQty, affordableQty)
                    float firstQty = math.floor(qty * partialPercent / 100 / qtyStep + 1e-9) * qtyStep
                    float runnerQty = qty - firstQty
                    bool riskOk = risk >= minStopPips * pipSize - syminfo.mintick * 0.001 and risk <= maxStopPips * pipSize + syminfo.mintick * 0.001
                    bool sizingOk = qty > 0 and firstQty >= qtyStep and runnerQty >= qtyStep - 1e-9 and firstQty / qty >= 0.5 - 1e-9 and firstQty / qty <= 0.8 + 1e-9
                    bool notChasing = isBuy ? entry <= setup.chaseBoundary : entry >= setup.chaseBoundary
                    bool passiveLimit = isBuy ? entry < close : entry > close
                    bool executionOk = notChasing and (marketOrder or (passiveLimit and nextWindow))
                    if riskOk and sizingOk and executionOk
                        trade := TradePlan.new()
                        trade.active := true
                        trade.market := marketOrder
                        trade.side := setup.side
                        trade.sentBar := bar_index
                        trade.entry := entry
                        trade.initialStop := stop
                        trade.invalidation := setup.extreme
                        trade.chaseBoundary := setup.chaseBoundary
                        trade.risk := risk
                        trade.tp1 := math.round_to_mintick(entry + setup.side * tp1R * risk)
                        trade.tp2 := math.round_to_mintick(entry + setup.side * tp2R * risk)
                        trade.qty := qty
                        trade.firstQty := firstQty
                        trade.runnerQty := runnerQty
                        trade.riskBudget := budget
                        trade.netAtStart := strategy.netprofit
                        string message = (isBuy ? "BUY" : "SELL") + " | " + syminfo.tickerid + " | " + setup.kind + " | qty=" + str.tostring(qty) + " | plan=" + f_price(entry) + " | SL=" + f_price(stop) + " | TP1=" + f_price(trade.tp1) + " | TP2=" + f_price(trade.tp2)
                        if isBuy
                            if marketOrder
                                strategy.entry("L", strategy.long, qty = qty, alert_message = message)
                            else
                                strategy.entry("L", strategy.long, qty = qty, limit = entry, alert_message = message)
                            buyOrderMark := true
                        else
                            if marketOrder
                                strategy.entry("S", strategy.short, qty = qty, alert_message = message)
                            else
                                strategy.entry("S", strategy.short, qty = qty, limit = entry, alert_message = message)
                            sellOrderMark := true
                        orderCount += 1
                        lastStatus := setup.kind + (marketOrder ? ": market dikirim." : ": tunggu retest limit baru.")
                    else if not riskOk
                        riskRejected += 1
                        lastStatus := "Ditolak: SL " + str.tostring(risk / pipSize, "#.##") + " pip, di luar batas."
                    else if not sizingOk
                        sizingRejected += 1
                        lastStatus := "Ditolak: qty / split / margin di bawah minimum."
                    else
                        executionRejected += 1
                        lastStatus := "Ditolak: chasing / limit tidak pasif / jendela berikutnya."
                    setup := ScalpSetup.new()

    // Qty tiap leg dibekukan; TP1 tidak dibuat ulang setelah parsial terisi.
    if trade.active and not trade.closing
        float activeStop = trade.breakEven ? trade.entry : trade.initialStop
        string stopComment = trade.breakEven ? "BE harga (biaya tetap ada)" : "SL struktur"
        if trade.side == 1
            if not trade.firstLegClosed
                strategy.exit("L-TP1", "L", qty = trade.firstQty, stop = activeStop, limit = trade.tp1, oca_name = "L-bracket-1", comment_profit = "TP1", comment_loss = stopComment, alert_profit = "L TP1 terisi", alert_loss = "L " + stopComment)
            strategy.exit("L-TP2", "L", qty = trade.runnerQty, stop = activeStop, limit = trade.tp2, oca_name = "L-bracket-2", comment_profit = "TP2", comment_loss = stopComment, alert_profit = "L TP2 terisi", alert_loss = "L " + stopComment)
        else
            if not trade.firstLegClosed
                strategy.exit("S-TP1", "S", qty = trade.firstQty, stop = activeStop, limit = trade.tp1, oca_name = "S-bracket-1", comment_profit = "TP1", comment_loss = stopComment, alert_profit = "S TP1 terisi", alert_loss = "S " + stopComment)
            strategy.exit("S-TP2", "S", qty = trade.runnerQty, stop = activeStop, limit = trade.tp2, oca_name = "S-bracket-2", comment_profit = "TP2", comment_loss = stopComment, alert_profit = "S TP2 terisi", alert_loss = "S " + stopComment)

plot(showLevels ? emaFast : na, "EMA cepat", color = color.aqua)
plot(showLevels ? emaSlow : na, "EMA lambat", color = color.orange)
plot(showLevels and setup.side != 0 ? setup.reference : na, "Referensi setup terkunci", color = color.yellow, style = plot.style_linebr)
plot(showLevels and trade.active ? trade.entry : na, "Entry rencana / fill", color = color.white, style = plot.style_linebr)
plot(showLevels and trade.active ? (trade.breakEven ? trade.entry : trade.initialStop) : na, "SL / BEP", color = color.red, style = plot.style_linebr)
plot(showLevels and trade.active ? trade.tp1 : na, "TP1", color = color.lime, style = plot.style_linebr)
plot(showLevels and trade.active ? trade.tp2 : na, "TP2", color = color.teal, style = plot.style_linebr)
plotshape(buySetupMark, "Setup buy", shape.triangleup, location.belowbar, color.aqua, text = "SET", size = size.tiny)
plotshape(sellSetupMark, "Setup sell", shape.triangledown, location.abovebar, color.orange, text = "SET", size = size.tiny)
plotshape(buyOrderMark, "Order buy dikirim", shape.labelup, location.belowbar, color.green, text = "BUY", textcolor = color.white, size = size.tiny)
plotshape(sellOrderMark, "Order sell dikirim", shape.labeldown, location.abovebar, color.red, text = "SELL", textcolor = color.white, size = size.tiny)
bgcolor(showSessions ? (newsNow ? color.new(color.red, 85) : f_session(time) ? color.new(color.blue, 94) : na) : na)

var table dashboard = table.new(position.top_right, 2, 19, bgcolor = color.new(color.black, 12), border_width = 1)
if barstate.islast and showDashboard
    float winRate = completed > 0 ? 100.0 * winners / completed : na
    float lowerBound = f_wilsonLower(winners, completed)
    bool evidenceStrong = completed >= minimumSample and lowerBound > 50 and winningPnl > losingPnl
    color resultColor = evidenceStrong ? color.lime : color.orange
    string phase = trade.active ? (trade.filled ? "Posisi aktif" : "Order menunggu fill") : setup.side != 0 ? setup.kind + ": tunggu trigger" : "Tunggu pullback / sweep baru"
    string windowText = not calendarReviewed ? "TERKUNCI: verifikasi kalender" : time_close < calendarStart or time_close > calendarEnd ? "TERKUNCI: cakupan kalender" : newsNow ? "BLACKOUT +/-15 menit" : currentWindow ? "Sesi aktif; " + str.tostring(array.size(newsEvents)) + " berita manual" : "Di luar jendela entri"
    f_row(dashboard, 0, "XAU Active Scalper M5/M15", "Target WR >50%, bukan jaminan", color.yellow)
    f_row(dashboard, 1, "Tahap", phase, color.white)
    f_row(dashboard, 2, "Status terakhir", lastStatus, color.white)
    f_row(dashboard, 3, "Waktu / berita", windowText, currentWindow ? color.lime : color.orange)
    f_row(dashboard, 4, "Bias / ADX / HTF", (buyBias ? "BUY" : sellBias ? "SELL" : "Netral") + " / " + str.tostring(adx, "#.0") + " / " + (useBias ? biasTf : "off"), color.white)
    f_row(dashboard, 5, "Setup -> trigger -> order", str.tostring(setupCount) + " -> " + str.tostring(triggerCount) + " -> " + str.tostring(orderCount), color.white)
    f_row(dashboard, 6, "Tolak SL / qty / eksekusi", str.tostring(riskRejected) + " / " + str.tostring(sizingRejected) + " / " + str.tostring(executionRejected), color.orange)
    f_row(dashboard, 7, "Entry / SL awal", f_price(trade.entry) + " / " + f_price(trade.initialStop), color.white)
    f_row(dashboard, 8, "TP1 / TP2", f_price(trade.tp1) + " / " + f_price(trade.tp2), color.lime)
    f_row(dashboard, 9, "Risiko / lot standar*", trade.active ? str.tostring(trade.risk / pipSize, "#.##") + " pip / " + str.tostring(trade.qty * syminfo.pointvalue / 100, "#.###") : "-", color.white)
    f_row(dashboard, 10, "BEP (close, bukan intrabar)", trade.breakEven ? "Aktif; bukan bebas biaya/gap" : "Tunggu " + str.tostring(beAtR, "#.##") + "R", color.white)
    f_row(dashboard, 11, "Entry hari ini / net", str.tostring(dailyEntries) + "/" + str.tostring(maxTradesDay) + " / $" + str.tostring(strategy.netprofit - dayStartNet, "#.##"), color.white)
    f_row(dashboard, 12, "Posisi utuh W / L / BE", str.tostring(winners) + " / " + str.tostring(losers) + " / " + str.tostring(completed - winners - losers), color.white)
    f_row(dashboard, 13, "WR net / batas bawah 95%*", completed > 0 ? str.tostring(winRate, "#.##") + "% / " + str.tostring(lowerBound, "#.##") + "%" : "Belum ada posisi selesai", resultColor)
    f_row(dashboard, 14, "Sampel selesai / minimum", str.tostring(completed) + " / " + str.tostring(minimumSample), resultColor)
    f_row(dashboard, 15, "Profit factor posisi utuh", losingPnl > 0 ? str.tostring(winningPnl / losingPnl, "#.##") : winningPnl > 0 ? "Belum ada loss" : "-", color.white)
    f_row(dashboard, 16, "Fill / hari eligible", eligibleDays > 0 ? str.tostring(totalFills) + " / " + str.tostring(eligibleDays) + " = " + str.tostring(1.0 * totalFills / eligibleDays, "#.##") + "/hari" : "Belum ada hari eligible", color.white)
    f_row(dashboard, 17, "Max DD / pending batal", "$" + str.tostring(strategy.max_drawdown, "#.##") + " / " + str.tostring(cancelledOrders), color.white)
    f_row(dashboard, 18, "Time exit / validasi", str.tostring(maxHoldMinutes) + " menit; wajib OOS + forward test", color.yellow)
